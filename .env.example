ACIL_DATABASE_URL=postgresql+psycopg://acil:acil@localhost:5432/acil
ACIL_API_KEY=acil-dev-key
ACIL_LOG_LEVEL=INFO
# Agent workspace routing (safe identifiers; never put tenant API keys here).
ACIL_MCP_SERVER=acil
ACIL_TENANT_ID=425ac4b9-5ecc-4cf5-91bf-ed93161feee8
ACIL_PROJECT_ID=9e7cd4c5-9ebb-44fb-af26-1a965f7ec4e8
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1
# Gemini 3.6 Flash-Lite is not a published model ID. The Lite production model is 3.5.
GEMINI_AUTH_MODE=vertex_adc
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=LOW
GEMINI_MAX_OUTPUT_TOKENS=1024
# Do not commit this file path or the referenced service-account JSON to source control.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/acil-vertex-judge-service-account.json
# Amazon Bedrock judge: use either BEDROCK_API_KEY or standard AWS IAM/SSO credentials.
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=in.moonshotai.kimi-k3
BEDROCK_MAX_OUTPUT_TOKENS=512
KIMI_CHAT_MAX_OUTPUT_TOKENS=2048
BEDROCK_TEMPERATURE=0.2
BEDROCK_REASONING_EFFORT=low
BEDROCK_AUTH_MODE=iam
# Set only when BEDROCK_AUTH_MODE=api_key. Keep it in a secret manager, never Git.
# BEDROCK_API_KEY=
# AWS_PROFILE=bedrock-mumbai
# Explicit opt-in only: a prebuilt image containing the controlled evaluation repository.
ACIL_EVALUATION_RUNNER_ENABLED=false
ACIL_EVALUATION_DOCKER_IMAGE=ghcr.io/your-org/acil-evaluation-target:latest
ACIL_EVALUATION_TIMEOUT_SECONDS=120
